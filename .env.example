# Copier ce fichier en .env puis renseigner les valeurs. NE JAMAIS committer .env.
# Token personnel Infoclimat (necessaire uniquement pour la collecte reelle)
INFOCLIMAT_TOKEN=
INFOCLIMAT_URL=https://www.infoclimat.fr/opendata/
# Cle optionnelle pour proteger l'API (si vide : API ouverte, usage local/demo)
GOUTTE_API_KEY=
GOUTTE_DB_PATH=database/goutte_eau.db
GOUTTE_MODEL_PATH=models/rain_model.joblib
GOUTTE_API_URL=http://127.0.0.1:8000
